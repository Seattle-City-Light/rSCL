mutate(YEAR_MONTH = ymd(paste(YEAR,MONTH,1))) %>%
ggplot(aes(x=YEAR_MONTH))+
geom_line(aes(y=AVG_TEMP))+
geom_line(aes(y=MIN_TEMP))+
geom_line(aes(y=MAX_TEMP))+
theme_minimal()
weather_data %>%
rename(DATETIME = DATETIME_UTC) %>%
create_datetime_cols() %>%
group_by(YEAR,MONTH) %>%
summarise(AVG_TEMP = mean(TEMPERATURE,na.rm=T),
MIN_TEMP = min(TEMPERATURE,na.rm=T),
MAX_TEMP = max(TEMPERATURE,na.rm=T)) %>%
mutate(YEAR_MONTH = ymd(paste(YEAR,MONTH,1))) %>%
ggplot(aes(x=YEAR_MONTH))+
geom_line(aes(y=AVG_TEMP))+
geom_line(aes(y=MIN_TEMP))+
geom_line(aes(y=MAX_TEMP))+
theme_minimal()
